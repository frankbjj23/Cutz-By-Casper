# Required only for the invitation-only /preview feature.
OPENAI_API_KEY=

# Required in every environment where the invitation-only preview is enabled.
# Use a SHA-256 hash so the invitation code itself is never stored in source.
STYLE_PREVIEW_ACCESS_HASH=

# Optional: pin a tested image-model snapshot or override the same-origin check.
STYLE_PREVIEW_MODEL=gpt-image-2-2026-04-21
STYLE_PREVIEW_ALLOWED_ORIGIN=http://localhost:3000

# Optional exact-origin override for the booking-contact receiver. Production
# defaults to https://redeemedbycasper.com; set this for nonstandard local hosts.
BOOKING_CONTACT_ALLOWED_ORIGIN=http://localhost:3000

# Optional server-side overrides for the public Supabase receiver identity.
# The checked-in defaults are public identifiers, not database secrets.
BOOKING_CONTACT_SUPABASE_URL=
BOOKING_CONTACT_SUPABASE_PUBLISHABLE_KEY=

# Optional exact-origin and receiver overrides for moderated website reviews.
# Production defaults to redeemedbycasper.com and the current Supabase project.
REVIEW_ALLOWED_ORIGIN=http://localhost:3000
REVIEW_SUPABASE_URL=
REVIEW_SUPABASE_PUBLISHABLE_KEY=
# Required 64-character lowercase hex secret shared only by Vercel and Edge.
REVIEW_RECEIVER_SECRET=

# Private custom-booking foundation. These intentionally use booking-specific
# names so the site cannot accidentally connect to the retired legacy project.
NEXT_PUBLIC_BOOKING_SUPABASE_URL=
NEXT_PUBLIC_BOOKING_SUPABASE_PUBLISHABLE_KEY=

# Added in the Stripe/customer-calendar phase, never exposed to the browser.
BOOKING_SUPABASE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
